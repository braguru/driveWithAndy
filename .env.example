# Copy this file to .env and fill in real values. Never commit .env.

# Google Maps Platform key. Needs Places API (New) + Maps Embed API enabled
# on a project with active billing. Used server-side and served to the browser.
GOOGLE_MAP_API=your-google-maps-platform-key

# Booking number, format 233XXXXXXXXX (country code, no +).
WHATSAPP_NUMBER=233000000000

# Port for the local server. Defaults to 3000 if unset.
PORT=3000

# SMTP settings for the contact form (Nodemailer).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-or-app-password
SMTP_FROM=you@example.com
SMTP_TO=where-enquiries-go@example.com

# ── Admin media manager ──────────────────────────────────────
# Vercel Blob store token. Create the store in the Vercel dashboard under
# Storage, then run `vercel env pull` to get this locally. Without it the
# site falls back to the images committed in content/ and /admin is disabled.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# The one address allowed to sign in to /admin.
ADMIN_EMAIL=andy@example.com

# Signs the admin session cookie. Use a long random string, for example
# `openssl rand -base64 32`. Changing it signs everyone out immediately.
ADMIN_SESSION_SECRET=generate-a-long-random-string
